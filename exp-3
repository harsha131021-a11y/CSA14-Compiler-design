#include <stdio.h>

int main()
{
    char ch;

    printf("Enter text (Press Ctrl+D to stop):\n");

    while ((ch = getchar()) != EOF)
    {
        if (ch == ' ' || ch == '\t' || ch == '\n')
            continue;

        putchar(ch);
    }

    return 0;
}

